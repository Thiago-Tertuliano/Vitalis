SERVICE_NAME=vitalis-gateway
APP_ENV=local
HTTP_ADDR=:8080

JWKS_URL=http://127.0.0.1:8081/v1/auth/jwks.json
JWKS_REFRESH_MIN=10
JWT_ISSUER=vitalis-identity
JWT_AUDIENCE=vitalis

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
MAX_BODY_MB=10
UPSTREAM_TIMEOUT_SEC=30
SHUTDOWN_TIMEOUT_SEC=10

UPSTREAM_IDENTITY=http://127.0.0.1:8081
UPSTREAM_CLINICAL=http://127.0.0.1:8082
UPSTREAM_COMMERCE=http://127.0.0.1:8083
UPSTREAM_ORDERS=http://127.0.0.1:8084
UPSTREAM_DELIVERY=http://127.0.0.1:8085
UPSTREAM_BILLING=http://127.0.0.1:8086
UPSTREAM_COMMS=http://127.0.0.1:8087
UPSTREAM_SUPPORT=http://127.0.0.1:8088
UPSTREAM_FILES=http://127.0.0.1:8089
UPSTREAM_SEARCH=http://127.0.0.1:8090
UPSTREAM_AUDIT=http://127.0.0.1:8091
