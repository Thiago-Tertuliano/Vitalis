SERVICE_NAME=vitalis-identity
APP_ENV=local
HTTP_ADDR=:8081

# Host 5433 = mapeamento do docker-compose (evita conflito com Postgres local na 5432)
DATABASE_URL=postgres://vitalis:vitalis@127.0.0.1:5433/pg_identity?sslmode=disable

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
EVENTS_STREAM=vitalis.events

SHUTDOWN_TIMEOUT_SEC=10

# JWT RS256 (pasta local com chaves — geramos na Fase 5)
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
JWT_ISSUER=vitalis-identity
JWT_AUDIENCE=vitalis
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7