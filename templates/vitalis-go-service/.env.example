# Copie para .env e ajuste.
SERVICE_NAME=vitalis-service-template
APP_ENV=local
HTTP_ADDR=:8080

# Postgres (database-per-service)
DATABASE_URL=postgres://vitalis:vitalis@localhost:5432/vitalis_service?sslmode=disable

# Redis (cache + streams)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
EVENTS_STREAM=vitalis.events

SHUTDOWN_TIMEOUT_SEC=10
